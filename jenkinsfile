pipeline {
    agent { label 'my-node-01' }   // yahan apne agent ka naam ya label likho

    stages {
        stage('Check Agent') {
            steps {
                sh 'hostname && whoami'
            }
        }

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install & Start Nginx') {
            steps {
                sh '''
                  sudo yum install -y nginx
                  sudo systemctl start nginx
                  sudo systemctl enable nginx
                '''
            }
        }
        stage('copy index.html /var/www/html') {
             steps {
                sh '''
                  sudo cp /home/ec2-user/jenkins/workspace/pipeline-project/index.html  /usr/share/nginx/html
                '''
             }
        }
    }
}
