pipeline {
    agent { label 'my-node-01' }   // yahan apne agent ka naam ya label likho

    stages {
        stage('Check Agent') {
            steps {
                sh 'hostname && whoami'
            }
        }

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install & Start Nginx') {
            steps {
                sh '''
                  sudo yum install -y httpd
                  sudo systemctl start httpd
                  sudo systemctl enable httpd
                '''
            }
        }
        stage('copy index.html') {
             steps {
                 sh '''
                   sudo cp /home/ec2-user/jenkins/workspace/pipeline/index.html  /var/www/html
            }
         }
           
    } 
}
